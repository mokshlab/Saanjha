# Copy this file to .local/.env for local development.
NODE_ENV=development
PORT=3101
MONGODB_URI=mongodb://127.0.0.1:27017/saanjha
JWT_SECRET=replace-with-a-long-local-secret
ADMIN_EMAIL=admin@chitkara.edu.in
ADMIN_PASSWORD=replace-with-a-local-admin-password
CAMPUS_NAME=Example University
CAMPUS_EMAIL_DOMAIN=chitkara.edu.in
MAX_FILE_SIZE=5242880

# Optional email delivery
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OTP_FROM=

# Optional Cloudinary storage; blank values use local uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=saanjha/listings

# Optional frontend settings
VITE_FRONTEND_PORT=5174
VITE_BACKEND_URL=http://127.0.0.1:3101
VITE_API_BASE_URL=/api
